{
  "compilerOptions": {
    // 🔕 Silencia advertencias deprecadas de TypeScript 6.x (útil en VS Code)
    "ignoreDeprecations": "6.0",

    // Permitir analizar y validar archivos .js además de .ts
    "allowJs": true,

    // Revisar errores también en archivos .js (útil si usas JSDoc para tipos)
    "checkJs": true,

    // Permitir imports por default de módulos CommonJS sin error
    "esModuleInterop": true,

    // Usar módulos ES modernos
    "module": "esnext",

    // Generar código moderno compatible con navegadores actuales
    "target": "esnext",

    // Reemplaza node/node10 (deprecated) por resolución moderna compatible con bundlers (Vite / Nuxt)
    "moduleResolution": "bundler",

    // Incluir tipados para el DOM y APIs modernas de JavaScript
    "lib": ["dom", "esnext"],

    // No verificar tipados internos de librerías externas para acelerar compilación
    "skipLibCheck": true,

    // Desactivar chequeo estricto (poner true para máxima seguridad)
    "strict": false,

    // No emitir archivos compilados; solo verifica tipos (Vite se encarga de la compilación)
    "noEmit": true,

    // Base para resolución de paths y módulos, apunta a carpeta 'resources'
    "baseUrl": "./resources",

    // Alias para módulos
    "paths": {
      // Alias '@' para todo dentro de 'resources', ejemplo: '@/css/global.css'
      "@/*": ["*"],

      // Alias '@js' para la carpeta 'resources/js', ejemplo: '@js/components/Comp.vue'
      "@js/*": ["js/*"]
    }
  },

  // Archivos y carpetas que TypeScript debe analizar para tipado y lint
  "include": [
    "resources/js/**/*"
  ],

  // Carpetas que TypeScript debe ignorar
  "exclude": [
    "node_modules",
    "public"
  ]
}
