{
  "compilerOptions": {
    // Permitir analizar y validar archivos .js además de .ts
    "allowJs": true,
    // Revisar errores también en archivos .js (útil si usas JSDoc para tipos)
    "checkJs": true,
    // Permitir imports por default de módulos CommonJS sin error
    "esModuleInterop": true,
    // Usar módulos ES modernos
    "module": "esnext",
    // Generar código moderno compatible con navegadores actuales
    "target": "esnext",
    // Resolver imports como Node.js (busca en node_modules, index.js, etc.)
    "moduleResolution": "node",
    // Incluir tipados para el DOM y todas las APIs modernas de JavaScript
    "lib": [
      "dom",
      "esnext"
    ],
    // No verificar tipados internos de librerías externas (acelera el build)
    "skipLibCheck": true,
    // Desactivar chequeo estricto de tipos (puedes poner true si quieres máxima seguridad)
    "strict": false,
    // No emitir archivos compilados; solo verificar tipos (Vite se encarga de compilar)
    "noEmit": true,
    // **Alias @ configurado para apuntar a resources/js**
    "baseUrl": "./resources/js",
    "paths": {
      "@/*": ["*"]
    }
  },
  // Archivos y carpetas que TypeScript debe analizar
  "include": [
    "resources/js/**/*"
  ],
  // Carpetas que TypeScript debe ignorar
  "exclude": [
    "node_modules",
    "public"
  ]
}
