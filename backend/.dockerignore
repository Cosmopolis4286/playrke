# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.log

# Build artifacts
build/
dist/
public/hot
public/storage

# Dependencies (keep lock files for reproducible builds)
vendor/
node_modules/

# Scripts
deploy.sh
scripts/local/*

# CI/CD
.github/
!.github/workflows/backend-ci.yml

# Docker files that are not needed in image
Dockerfile.dev
docker-compose.dev.yml
docker-compose.test.yml

# Configuration files (keep examples)
config/local/
.env.local
.env.staging
.env.production

# Database
database/database.sqlite
database/factories/
database/seeders/

# Language files (keep only needed)
lang/tests/

# Assets source files (keep compiled)
resources/js/
resources/sass/
resources/css/
!public/build/

# Cache and logs
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*

# Keep important files
!storage/framework/cache/data/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep
!storage/logs/.gitkeep
