{
  "name": "playrke-backend",
  "version": "1.0.0",
  "description": "Modern Node.js backend API for PlayRKE - Progressive migration from Laravel",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset-db.ts"
  },
  "keywords": ["nodejs", "typescript", "api", "authentication", "2fa", "jwt"],
  "author": "PlayRKE Team",
  "license": "MIT",
  "dependencies": {
    "fastify": "^4.24.3",
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/jwt": "^7.2.4",
    "@fastify/cookie": "^9.2.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/static": "^6.12.0",
    "prisma": "^5.7.1",
    "@prisma/client": "^5.7.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.3",
    "nodemailer": "^6.9.7",
    "@types/nodemailer": "^6.4.14",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1",
    "redis": "^4.6.10",
    "ioredis": "^5.3.2",
    "crypto": "^1.0.1",
    "uuid": "^9.0.1",
    "@types/uuid": "^9.0.7",
    "dayjs": "^1.11.10",
    "axios": "^1.6.2",
    "socket.io": "^4.7.4",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^2.1.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsx": "^4.6.2",
    "tsc-alias": "^1.8.8",
    "@types/node": "^20.10.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "vitest": "^1.0.4",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}