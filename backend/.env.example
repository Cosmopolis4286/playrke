################################
# APPLICATION
################################

APP_NAME="PlayRKE"
APP_ENV=local
BINGO_DEV_INTERVAL_SECONDS=3  # Segundos entre fichas en APP_ENV=local (0 = sin pausa, solo para tests)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
# Habilita /dev/demo-credentials (selector de cuentas demo en el login).
# Requiere ADEMÁS APP_ENV=local en runtime — ver DemoCredentialsController.
DEMO_CREDENTIALS_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US


################################
# FRONTEND (Vite / SPA)
################################

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME="${APP_NAME}"


################################
# SECURITY / SESSION
################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Sanctum SPA Domains (no protocol)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173


################################
# DATABASE
################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=playrke
DB_USERNAME=root
DB_PASSWORD=

# PostgreSQL para Trivia (DB separada)
DB_TRIVIA_HOST=127.0.0.1
DB_TRIVIA_PORT=5432
DB_TRIVIA_DATABASE=trivia
DB_TRIVIA_USERNAME=postgres
DB_TRIVIA_PASSWORD=
DB_TRIVIA_SCHEMA=public


################################
# CACHE / QUEUE
################################

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database
# Tiempo máximo (s) antes de que Laravel reencole un job "colgado".
# bingo-draw usa su propio valor — el sorteo puede durar hasta 75×30=2250 s.
DB_QUEUE_RETRY_AFTER=90
BINGO_DRAW_QUEUE_RETRY_AFTER=3600


################################
# LOGGING
################################

LOG_CHANNEL=stack
LOG_STACK=daily,database
LOG_DAILY_DAYS=14
LOG_LEVEL=debug

# Alertas críticas (excepciones no capturadas en producción, ver
# bootstrap/app.php) a un canal de Slack — agregar "slack" a LOG_STACK
# arriba y setear LOG_SLACK_WEBHOOK_URL para activarlo. Sin webhook
# configurado, el canal simplemente no dispara (no rompe el resto del stack).
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="PlayRKE Alerts"
LOG_SLACK_EMOJI=:boom:
LOG_SLACK_LEVEL=critical


################################
# REDIS
################################

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


################################
# FILESYSTEM
################################

FILESYSTEM_DISK=local


################################
# MAIL
################################

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


################################
# BROADCASTING (Laravel Reverb)
################################

BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Variables expuestas al frontend
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"


################################
# CLOUDFLARE TURNSTILE (captcha invisible)
################################
# Obligatorias en producción (ver App\Support\EnvValidator). Vacías en
# local/testing: App\Rules\CloudflareTurnstile falla abierto sin secret_key.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_TURNSTILE_SITE_KEY="${TURNSTILE_SITE_KEY}"


################################
# CONTENT SECURITY POLICY
################################
# false = Content-Security-Policy-Report-Only (no bloquea, solo reporta).
# Cambiar a true en producción solo tras confirmar sin violaciones inesperadas
# (ver App\Http\Middleware\SecurityHeaders y config/security.php).
CSP_ENFORCE=false


################################
# PAGOS USDT-TRC20 (TRON) — App\Domains\Payments
################################
# Ver PAYMENTS_USDT_TRC20_DESIGN.md. 'mock' solo para local/testing —
# PaymentServiceProvider rehúsa bindear MockBlockchainProvider en producción.
PAYMENTS_TRON_NETWORK=mainnet
PAYMENTS_TRON_PROVIDER=tron_grid
PAYMENTS_TRON_API_URL=https://api.trongrid.io
# API key gratuita de https://www.trongrid.io — sin ella, rate limit muy bajo.
PAYMENTS_TRON_API_KEY=
# Contrato oficial USDT-TRC20 en mainnet — nunca inferir por símbolo.
PAYMENTS_TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# XPUB de solo lectura para derivar direcciones — NUNCA la seed/private key.
PAYMENTS_TRON_XPUB=
PAYMENTS_TRON_CONFIRMATIONS_REQUIRED=19
PAYMENTS_ORDER_EXPIRATION_MINUTES=30