FROM php:8.4-fpm-alpine

ENV PHP_MEMORY_LIMIT=512M \
    PHP_UPLOAD_MAX_FILESIZE=100M \
    PHP_POST_MAX_SIZE=100M \
    PHP_MAX_EXECUTION_TIME=300

RUN apk add --no-cache \
    git curl zip unzip bash nano \
    libpng-dev libzip-dev oniguruma-dev icu-dev \
    freetype-dev libjpeg-turbo-dev libwebp-dev \
    postgresql-dev postgresql-libs \
    mysql-client \
    libxml2-dev libxslt-dev readline-dev sqlite-dev \
    nodejs npm linux-headers

RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
 && docker-php-ext-install \
    pdo_mysql pdo_pgsql mbstring exif pcntl bcmath \
    gd zip intl opcache pdo_sqlite xsl xml xmlwriter simplexml

RUN apk add --no-cache $PHPIZE_DEPS \
 && pecl install redis xdebug \
 && docker-php-ext-enable redis xdebug \
 && apk del $PHPIZE_DEPS

# OPcache: revalida en cada request para ver cambios al instante
RUN { \
        echo "opcache.memory_consumption=128"; \
        echo "opcache.max_accelerated_files=4000"; \
        echo "opcache.revalidate_freq=0"; \
        echo "opcache.validate_timestamps=1"; \
        echo "opcache.enable_cli=1"; \
    } > /usr/local/etc/php/conf.d/opcache.ini

# Xdebug apunta al IDE en el host Windows
RUN { \
        echo "xdebug.mode=debug,coverage"; \
        echo "xdebug.start_with_request=yes"; \
        echo "xdebug.client_host=host.docker.internal"; \
        echo "xdebug.client_port=9003"; \
        echo "xdebug.log_level=0"; \
    } > /usr/local/etc/php/conf.d/xdebug.ini

# PHP-FPM pool liviano
RUN { \
        echo "[www]"; \
        echo "user = www-data"; \
        echo "group = www-data"; \
        echo "listen = 9000"; \
        echo "listen.owner = www-data"; \
        echo "listen.group = www-data"; \
        echo "pm = dynamic"; \
        echo "pm.max_children = 10"; \
        echo "pm.start_servers = 2"; \
        echo "pm.min_spare_servers = 1"; \
        echo "pm.max_spare_servers = 4"; \
        echo "catch_workers_output = yes"; \
        echo "clear_env = no"; \
    } > /usr/local/etc/php-fpm.d/www.conf

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer
RUN npm install -g pnpm@10.25.0

WORKDIR /var/www

COPY composer.json composer.lock* ./
RUN composer install --no-scripts --no-autoloader --prefer-dist

COPY package.json* pnpm-lock.yaml* ./
RUN if [ -f package.json ]; then pnpm install --no-frozen-lockfile; fi

# Guardar vendor fuera de /var/www; el entrypoint lo restaura si el bind mount lo pisa
RUN cp -r vendor /vendor-cache

RUN mkdir -p \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
 && chown -R www-data:www-data storage bootstrap/cache \
 && chmod -R 775 storage bootstrap/cache

# Entrypoint inline — sin archivos externos
RUN printf '#!/bin/sh\nset -e\n\n# Restaurar vendor si el bind mount lo dejó vacío\nif [ ! -f /var/www/vendor/autoload.php ]; then\n    echo "[dev] Restaurando vendor..."\n    mkdir -p /var/www/vendor\n    cp -r /vendor-cache/. /var/www/vendor/\n    echo "[dev] Vendor listo."\nfi\n\n# Permisos de storage en cada arranque\nchown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache 2>/dev/null || true\nchmod -R 775 /var/www/storage /var/www/bootstrap/cache 2>/dev/null || true\n\nexec "$@"\n' > /usr/local/bin/entrypoint.sh \
 && chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 9000 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]
