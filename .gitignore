# ========================================
# Monorepo - Root Level
# ========================================

# Root node_modules (pnpm workspace)
/node_modules
/.pnpm-store

# ========================================
# Laravel Backend
# ========================================

# PHP
/backend/.phpunit.cache
/backend/vendor
/backend/.phpactor.json
/backend/.phpunit.result.cache
/backend/auth.json

# Backend node_modules (para Vite)
/backend/node_modules

# Storage & Cache
/backend/public/build
/backend/public/hot
/backend/public/storage
/backend/storage/*.key
/backend/bootstrap/cache/*

# Homestead
/backend/Homestead.json
/backend/Homestead.yaml

# ========================================
# Nuxt 3 Frontend
# ========================================

# Nuxt build outputs
/frontend/.output
/frontend/.nuxt
/frontend/.nitro
/frontend/.cache
/frontend/dist

# Frontend dependencies
/frontend/node_modules

# ========================================
# Environment & Secrets
# ========================================

# Root
.env
.env.*
!.env.example

# Backend
/backend/.env
/backend/.env.*
!/backend/.env.example
/backend/.env.backup
/backend/.env.production

# Frontend
/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# ========================================
# Logs
# ========================================

*.log
npm-debug.log
yarn-error.log
pnpm-debug.log
/backend/storage/logs/*.log

# ========================================
# IDEs & Editors
# ========================================

/.fleet
/.idea
/.vscode
/.claude

# Vim
*.swp
*.swo

# Sublime
*.sublime-workspace
*.sublime-project

# ========================================
# OS Files
# ========================================

.DS_Store
Thumbs.db
desktop.ini

# ========================================
# Testing & Coverage
# ========================================

/coverage
/.nyc_output
/frontend/coverage

# ========================================
# Temporary & Backup Files
# ========================================

*.tmp
*.bak
*.backup
*.swp
temp/
tmp/

# ========================================
# Build & Distribution
# ========================================

/backend/public/dist
/backend/public/mix-manifest.json
build-stats.html

# ========================================
# Lock Files (opcional - descomentar si no quieres commitear)
# ========================================

# composer.lock
# package-lock.json
# /frontend/package-lock.json
# yarn.lock
# pnpm-lock.yaml
