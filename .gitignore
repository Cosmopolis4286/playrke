# ========================================
# Monorepo - Root Level
# ========================================

# Root node_modules (pnpm workspace)
/node_modules
/.pnpm-store
/pnpm-lock.yaml

# Directorios scratch / de prueba sueltos (ej. scratch_bip32_check/)
scratch_*/

# ========================================
# Laravel Backend
# ========================================

# PHP
/backend/.phpunit.cache
/backend/.phpunit.cache/
/backend/.phpunit.result.cache
/backend/vendor
/backend/.phpactor.json
/backend/auth.json
/backend/.php-cs-fixer.cache
/backend/.php_cs.cache

# Backend node_modules (para Vite)
/backend/node_modules
/backend/.pnpm-store

# IDE Helper files (auto-generated)
/backend/_ide_helper.php
/backend/_ide_helper_models.php
/backend/.phpstorm.meta.php

# Storage & Cache
/backend/public/build
/backend/public/hot
/backend/public/storage
/backend/storage/*.key
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore

# Storage runtime (sesiones, vistas compiladas, cache de datos)
/backend/storage/framework/cache/data/*
!/backend/storage/framework/cache/data/.gitignore
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/storage/framework/testing/disks/*
/backend/storage/app/public/*
!/backend/storage/app/public/.gitignore
/backend/storage/logs/*
!/backend/storage/logs/.gitignore

# Homestead
/backend/Homestead.json
/backend/Homestead.yaml

# ========================================
# Nuxt 3 Frontend
# ========================================

# Nuxt build outputs
/frontend/.output
/frontend/.nuxt
/frontend/.nitro
/frontend/.cache
/frontend/dist

# Frontend dependencies
/frontend/node_modules
/frontend/.pnpm-store
/frontend/pnpm-lock.yaml

# ========================================
# Environment & Secrets
# ========================================

# Root
.env
.env.*
!.env.example
!.env.docker.example

# Backend
/backend/.env
/backend/.env.*
!/backend/.env.example
/backend/.env.backup
/backend/.env.production

# Frontend
/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# ========================================
# Logs
# ========================================

*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ========================================
# IDEs & Editors
# ========================================

/.fleet
/.idea
/.vscode
/.claude
*.iml

# Vim
*.swp
*.swo
*~

# Sublime
*.sublime-workspace
*.sublime-project

# ========================================
# OS Files
# ========================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*.stackdump

# ========================================
# Testing & Coverage
# ========================================

/coverage
/.nyc_output
/frontend/coverage
*.tsbuildinfo
.eslintcache

# ========================================
# Temporary & Backup Files
# ========================================

*.tmp
*.bak
*.backup
*.orig
*.rej
*.pid
temp/
tmp/

# ========================================
# Build & Distribution
# ========================================

/backend/public/dist
/backend/public/mix-manifest.json
build-stats.html

# ========================================
# Docker
# ========================================

# Docker volumes y datos persistentes
docker-compose.override.yml
!.dockerignore

# Documentación auto-generada
README-GENERATE-SECRETS.md

