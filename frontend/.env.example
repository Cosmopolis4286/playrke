# PlayRKE Bingo - Frontend Environment Variables
# Copia este archivo a .env y configura los valores

# ==============================================
# API CONFIGURATION
# ==============================================
# URL base de la API Laravel (sin /api al final)
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# ==============================================
# WEBSOCKET CONFIGURATION (Pusher/Reverb)
# ==============================================
# Pusher App Key (o 'local' para desarrollo con Reverb)
NUXT_PUBLIC_PUSHER_KEY=local

# Pusher Host (usar localhost para desarrollo)
NUXT_PUBLIC_PUSHER_HOST=localhost

# Pusher Port (6001 para Reverb, 443 para Pusher cloud)
NUXT_PUBLIC_PUSHER_PORT=6001

# Pusher Cluster (solo para Pusher cloud, ej: mt1, us2, eu)
NUXT_PUBLIC_PUSHER_CLUSTER=mt1

# Usar TLS/SSL (false para desarrollo, true para producción)
NUXT_PUBLIC_PUSHER_TLS=false

# ==============================================
# APP CONFIGURATION
# ==============================================
# Nombre de la aplicación
NUXT_PUBLIC_APP_NAME=PlayRKE Bingo

# URL base del sitio
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Entorno (development, staging, production)
NODE_ENV=development

# ==============================================
# OPTIONAL: ANALYTICS & MONITORING
# ==============================================
# Google Analytics ID (opcional)
# NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry DSN (opcional para error tracking)
# NUXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ==============================================
# OPTIONAL: EXTERNAL SERVICES
# ==============================================
# Recaptcha Site Key (opcional para formularios)
# NUXT_PUBLIC_RECAPTCHA_SITE_KEY=xxxxxxxxxxxxx

# ==============================================
# NOTES
# ==============================================
# - Variables con NUXT_PUBLIC_ están disponibles en el cliente
# - Variables sin NUXT_PUBLIC_ solo están disponibles en el servidor
# - Reinicia el servidor después de cambiar variables de entorno
# - NUNCA subas el archivo .env al repositorio (ya está en .gitignore)
