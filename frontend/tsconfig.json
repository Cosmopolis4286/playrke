{
  "extends": "./.nuxt/tsconfig.json",

  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",

    "strict": true,
    "noImplicitAny": false,
    "allowJs": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "types": ["nuxt", "@types/node"],

    "noEmit": true
  },

  "include": [
    "./app.vue",
    "./nuxt.config.ts",
    "./.nuxt/**/*.ts",
    "./components/**/*.vue",
    "./composables/**/*.ts",
    "./pages/**/*.vue",
    "./layouts/**/*.vue",
    "./plugins/**/*.ts",
    "./stores/**/*.ts",
    "./utils/**/*.ts",
    "./types/**/*.d.ts",
    "./layers/**/*.ts",
    "./layers/**/*.vue"
  ]
}