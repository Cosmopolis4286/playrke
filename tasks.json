{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Node 20 + npm run dev",
            "type": "shell",
            "command": "if (!(node -v | Select-String '^v20')) { nvm use 20 }; npm run dev",
            "isBackground": false,
            "presentation": {
                "panel": "shared",
                "echo": true,
                "focus": true,
                "reveal": "always",
                "showReuseMessage": false
            }
        }
    ]
}