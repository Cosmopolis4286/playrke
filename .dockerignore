# ============================================
# DOCUMENTACIÓN / META
# ============================================
*.md
*.txt
LICENSE
CHANGELOG.md
CONTRIBUTING.md
REORGANIZACION.md

# ============================================
# CONTROL DE VERSIONES
# ============================================
.git
.gitignore
.gitattributes
.github
.gitlab-ci.yml
.travis.yml
circle.yml

# ============================================
# EDITORES / SISTEMA
# ============================================
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ============================================
# NODE / DEPENDENCIAS
# ============================================
**/node_modules
**/bower_components

# PNPM / NPM / YARN LOGS
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# PNPM / LOCK FILES (se conserva el lockfile raíz para builds reproducibles)
pnpm-lock.yaml
!pnpm-lock.yaml
package-lock.json
yarn.lock

# ============================================
# PHP / LARAVEL DEPENDENCIAS Y ARTIFACTOS
# ============================================
**/vendor/

# Laravel runtime
backend/storage/app/*
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*

# Mantener estructura
!backend/storage/app/.gitignore
!backend/storage/framework/.gitignore
!backend/storage/framework/cache/.gitignore
!backend/storage/logs/.gitignore

# Laravel cache
backend/bootstrap/cache/*.php
backend/bootstrap/cache/packages.php
backend/bootstrap/cache/services.php

# Tests / Herramientas
backend/.phpunit.result.cache
backend/_ide_helper.php
backend/.php_cs.cache

# ============================================
# FRONTEND ARTIFACTS (NUXT 3/4)
# ============================================
frontend/.nuxt
frontend/.output
frontend/dist
frontend/.nitro
frontend/.cache

# ============================================
# ARTIFACTOS DE BUILD Y TEMPORALES
# ============================================
**/*.log
**/dist
**/build
**/.next
**/.cache
**/coverage
**/.nyc_output
**/test-results

# ============================================
# DOCKER
# ============================================
Dockerfile*
docker-compose*.yml
.dockerignore

# ============================================
# ENVIRONMENT (SE COPIAN MANUALMENTE)
# ============================================
**/.env
**/.env.*
!**/.env.example
