{
  "name": "playrke-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PlayRKE - Monorepo Laravel + Nuxt 4",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:backend": "cd backend && php artisan serve",
    "dev:frontend": "pnpm --filter playrke-frontend dev",
    "dev:assets": "pnpm --filter backend dev",
    "dev:reverb": "cd backend && php artisan reverb:start",
    "build": "pnpm run --parallel build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter playrke-frontend build",
    "install:all": "pnpm install && cd backend && composer install",
    "clean": "pnpm --parallel clean && rm -rf node_modules",
    "lint": "pnpm --parallel lint",
    "test": "pnpm --parallel test",
    "setup": "pnpm install:all && node scripts/generate-secrets.js",
    "generate:secrets": "node scripts/generate-secrets.js",
    "migrate": "cd backend && php artisan migrate",
    "migrate:fresh": "cd backend && php artisan migrate:fresh --seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "laravel-echo": "^2.3.1",
    "playwright": "^1.61.1",
    "pusher-js": "^8.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@inertiajs/progress": "^0.2.7",
    "@vueform/multiselect": "^2.6.11",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "floating-vue": "^5.2.2",
    "lodash": "^4.18.1",
    "yup": "^1.7.1",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
